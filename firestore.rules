rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- helpers --------
    // Cap any single document write at ~512 KB to mitigate abuse.
    function notTooBig() {
      return request.resource.size < 512 * 1024;
    }

    // -------- players collection --------
    // Doc id = normalized (lowercased) username. The app has no Firebase Auth,
    // so reads/writes must remain client-accessible, but we harden the most
    // sensitive field — `securityAnswerHash` — so a registered account cannot
    // be hijacked by overwriting its hash from another client.
    match /players/{username} {
      allow read: if true;

      // Create: anyone may claim a username that does not yet exist.
      // Constrain shape and size.
      allow create: if notTooBig()
        && request.resource.data.keys().hasOnly([
          'displayName',
          'color',
          'securityQuestion',
          'securityAnswerHash',
          'createdAt',
          'stats',
          'unregisteredStats',
          'rankedByLength',
          'playStats',
          'playByDifficulty',
          'friendsPlayStats'
        ])
        && (
          !('displayName' in request.resource.data)
          || request.resource.data.displayName is string
        )
        && (
          !('securityQuestion' in request.resource.data)
          || request.resource.data.securityQuestion is string
        )
        && (
          !('securityAnswerHash' in request.resource.data)
          || request.resource.data.securityAnswerHash is string
        );

      // Update: allowed, but once a `securityAnswerHash` is set, nobody may
      // change or remove it. This effectively makes registered accounts
      // tamper-resistant against drive-by clients.
      allow update: if notTooBig()
        && (
          !('securityAnswerHash' in resource.data)
          || (
            'securityAnswerHash' in request.resource.data
            && request.resource.data.securityAnswerHash == resource.data.securityAnswerHash
          )
        )
        // Prevent rewriting securityQuestion on a registered account.
        && (
          !('securityAnswerHash' in resource.data)
          || (
            !('securityQuestion' in request.resource.data)
            || request.resource.data.securityQuestion == resource.data.securityQuestion
          )
        );

      // No client-side deletes — leaderboards/stats stay intact.
      allow delete: if false;
    }

    // -------- sessions collection (Score-tracker share/view) --------
    // Short-lived game-state documents keyed by a 6-char share code. Ephemeral
    // by design; allow CRUD with a size limit and deny anything off-shape.
    match /sessions/{code} {
      allow read: if true;
      allow create, update: if notTooBig();
      allow delete: if true;
    }

    // -------- playSessions collection (Play vs. Friends) --------
    match /playSessions/{code} {
      allow read: if true;
      allow create, update: if notTooBig();
      allow delete: if true;

      // Allow subcollection writes for action requests, if used.
      match /{subDoc=**} {
        allow read: if true;
        allow create, update: if notTooBig();
        allow delete: if true;
      }
    }

    // -------- farts + fartAudio (Reet My Scheet) --------
    // Anyone may upload (no login) and rate, but only in the exact shapes the
    // app writes: new farts start with zero votes, a vote adds one to the
    // count and 1..10 to every category, and nothing is ever deleted.
    function fartCategories() {
      return ['toon', 'ritme', 'lengte', 'volume', 'timing', 'bereik'];
    }

    function fartSumsShapeOk(sums) {
      return sums is map
        && sums.keys().hasOnly(fartCategories())
        && sums.keys().hasAll(fartCategories());
    }

    function fartVoteOk(k) {
      let delta = request.resource.data.sums[k] - resource.data.sums[k];
      return delta >= 1 && delta <= 10;
    }

    match /farts/{fartId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'title', 'artist', 'durationMs', 'mimeType', 'source', 'peaks',
          'createdAt', 'ratingCount', 'sums'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'artist', 'durationMs', 'mimeType', 'source', 'peaks',
          'createdAt', 'ratingCount', 'sums'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.artist is string
        && request.resource.data.artist.size() <= 30
        && request.resource.data.durationMs is number
        && request.resource.data.durationMs > 0
        && request.resource.data.durationMs <= 21000
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 60
        && request.resource.data.source in ['recording', 'upload']
        && request.resource.data.peaks is list
        && request.resource.data.peaks.size() <= 128
        && request.resource.data.createdAt == request.time
        && request.resource.data.ratingCount == 0
        && fartSumsShapeOk(request.resource.data.sums)
        && request.resource.data.sums.values().hasOnly([0]);

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sums', 'ratingCount', 'lastRatedAt'])
        && request.resource.data.ratingCount == resource.data.ratingCount + 1
        && request.resource.data.lastRatedAt == request.time
        // Only the current categories may change; sums of retired categories
        // on older farts stay frozen.
        && request.resource.data.sums is map
        && request.resource.data.sums.diff(resource.data.sums).affectedKeys()
          .hasOnly(fartCategories())
        && fartVoteOk('toon')
        && fartVoteOk('ritme')
        && fartVoteOk('lengte')
        && fartVoteOk('volume')
        && fartVoteOk('timing')
        && fartVoteOk('bereik');

      allow delete: if false;
    }

    // Audio (base64) is kept apart so leaderboards don't download sound. It
    // can only be written in the same batch that creates its fart, and the
    // string cap keeps it under Firestore's 1 MiB document limit.
    match /fartAudio/{fartId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['data', 'mimeType'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 900000
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 60
        && !exists(/databases/$(database)/documents/farts/$(fartId))
        && existsAfter(/databases/$(database)/documents/farts/$(fartId));
      allow update, delete: if false;
    }

    // -------- everything else: deny --------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
